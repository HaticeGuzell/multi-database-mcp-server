# Local Docker test environment only.
# Copy this file to .env.docker and replace the placeholder values.
# For easiest local URL testing, use letters/numbers/underscore only.

MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_READER_PASSWORD=CHANGE_ME_MYSQL_READER
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN
POSTGRES_READER_PASSWORD=CHANGE_ME_POSTGRES_READER

# Optional host-side ports (change if 3307 or 5433 are already in use).
# MCP containers always connect to the internal service ports 3306 / 5432.
MYSQL_HOST_PORT=3307
POSTGRES_HOST_PORT=5433
