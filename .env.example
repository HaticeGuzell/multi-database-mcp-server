# Host-based MCP connection (when databases run through this repository's Compose setup).
# Copy to .env and replace placeholders with your own local reader passwords.
# Use the values from .env.docker; never commit real credentials.
# If you changed *_HOST_PORT in .env.docker, update the port below accordingly.
DB_TYPE=postgres
DB_URL=postgresql://mcp_reader_pg:<POSTGRES_READER_PASSWORD>@127.0.0.1:5433/northwind

# Alternative MySQL configuration:
# DB_TYPE=mysql
# DB_URL=mysql://mcp_reader:<MYSQL_READER_PASSWORD>@127.0.0.1:3307/northwind
# URL-encode reserved characters in connection-string passwords.
